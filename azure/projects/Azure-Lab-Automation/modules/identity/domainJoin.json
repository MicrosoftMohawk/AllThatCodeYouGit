          "OUPath": "[parameters('ouPath')]",
          "User": "[parameters('domainJoinUser')]",
          "Restart": "true",
          "Options": "[variables('domainJoinOptions')]"
        },
        "protectedSettings": {
          "Password": "[parameters('domainJoinPassword')]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Compute/virtualMachines/runCommands', split(format('{0}/DnsReadyCheck', parameters('vmName')), '/')[0], split(format('{0}/DnsReadyCheck', parameters('vmName')), '/')[1])]"
      ]
    }
  ],
  "outputs": {
